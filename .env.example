# Copy to .env for local development. Never commit .env.
# On Railway, set these as service variables instead.
#
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True

# --- Production (Railway variables) ---------------------------------------
# DATABASE_URL=postgres://...           # set automatically when you add Railway Postgres
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com,.up.railway.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# DJANGO_ADMIN_URL=manage-7f3k/         # anything non-obvious instead of admin/
# DJANGO_HSTS_SECONDS=3600              # raise to 31536000 once HTTPS is stable
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=False  # True only if every subdomain is HTTPS
# MEDIA_ROOT=/data/media                # path of a mounted Railway volume

# --- SEO --------------------------------------------------------------------
# SITE_URL=https://example.com          # canonical links + structured data
# CANONICAL_HOST=example.com            # redirect www.example.com -> example.com
# SITE_NOINDEX=True                     # on previews; remove at launch

# --- Email ------------------------------------------------------------------
# POSTMARK_SERVER_TOKEN=...             # without it, emails print to the console
# DEFAULT_FROM_EMAIL=Example Business <website@example.com>
# CONTACT_EMAIL=owner@example.com       # receives contact form notifications

# --- Locale -----------------------------------------------------------------
# LANGUAGE_CODE=en
# TIME_ZONE=Europe/Istanbul
